{
  "name": "product-extractor",
  "version": "1.0.0",
  "description": "Extract structured product details (JSON) from product images, barcodes and invoice/receipt photos using Groq vision models",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "product-extractor": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node examples/demo.js",
    "server": "node server/server.js"
  },
  "keywords": [
    "product",
    "ocr",
    "vision",
    "groq",
    "barcode",
    "invoice",
    "ecommerce"
  ],
  "license": "MIT",
  "dependencies": {
    "@undecaf/zbar-wasm": "^0.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "groq-sdk": "^0.7.0",
    "multer": "^1.4.4",
    "playwright": "^1.61.0",
    "puppeteer": "^23.11.1",
    "sharp": "^0.33.5"
  }
}
